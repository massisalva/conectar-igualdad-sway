# Catppuccin Mocha para PyRadio
# Formato compatible con PyRadio actual.

# Main foreground and background
Stations            #CDD6F4 #1E1E2E

# Playing station text color (the background comes from Stations)
Active Station      #A6E3A1

# Status bar foreground and background
Status Bar          #1E1E2E #A6E3A1

# Normal cursor foreground and background
Normal Cursor       #CDD6F4 #313244

# Cursor foreground and background when on the playing station
Active Cursor       #1E1E2E #B4BEFE

# Line editor cursor foreground and background
Edit Cursor         #1E1E2E #F5E0DC

# Extra function indication and jump numbers
Extra Func          #CBA6F7

# URL text color
PyRadio URL         #CBA6F7

# Luminance factor for secondary-window backgrounds
Color Factor        0.06

# Message border; background is calculated by PyRadio
Messages Border     #CBA6F7

# 0: opaque, 1: transparent, 2: obey PyRadio's config setting
transparency        2
