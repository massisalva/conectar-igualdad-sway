# Conexión
mpd_host = 127.0.0.1
mpd_port = 6600

# Directorios
mpd_music_dir = ~/Música
lyrics_directory = ~/.local/share/ncmpcpp/lyrics

# Interfaz
user_interface = alternative
alternative_ui_separator_color = blue
alternative_header_first_line_format = {$b$5 %t $9$b}
alternative_header_second_line_format = {$3%a$9 - $7%b$9 ($4%y$9)}
startup_screen = playlist
startup_slave_screen = ""
startup_slave_screen_focus = no
screen_switcher_mode = playlist, browser, search_engine, playlist_editor, visualizer
locked_screen_width_part = 35
ask_for_locked_screen_width_part = no
playlist_display_mode = columns
browser_display_mode = columns
search_engine_display_mode = columns
playlist_editor_display_mode = columns
playlist_show_remaining_time = yes
playlist_shorten_total_times = yes
playlist_separate_albums = no
playlist_disable_highlight_delay = 0
song_columns_list_format = (58)[white]{t|f} (24)[cyan]{a|Desconocido} (5f)[blue]{l}
song_list_format = {%t}|{%f}$R{$3%l$9}
song_status_format = $b{{$8"%t"}} $3by {$4%a{ $3from $7%b{ $3($4%y$3)}}}$9
now_playing_prefix = "$b$2▶ $9"
now_playing_suffix = "$/b"
current_item_prefix = "$(cyan)$r"
current_item_suffix = "$/r$(end)"
current_item_inactive_column_prefix = "$(white)$r"
current_item_inactive_column_suffix = "$/r$(end)"
selected_item_prefix = "$(magenta)$r"
selected_item_suffix = "$/r$(end)"
discard_colors_if_item_is_selected = yes

# Colores Catppuccin
colors_enabled = yes
main_window_color = white
color1 = cyan
color2 = magenta
header_window_color = blue
volume_color = green
state_line_color = blue
state_flags_color = magenta
progressbar_color = blue
progressbar_elapsed_color = magenta
statusbar_color = white
statusbar_time_color = cyan
player_state_color = green

# Barra de progreso
progressbar_look = ─╼

# Visualizador
visualizer_data_source = /tmp/mpd.fifo
visualizer_output_name = Visualizer
visualizer_in_stereo = yes
visualizer_type = spectrum
visualizer_look = ▐█
visualizer_fps = 30
visualizer_autoscale = yes
visualizer_spectrum_smooth_look = yes
visualizer_spectrum_dft_size = 2
visualizer_spectrum_gain = 8
visualizer_color = blue, cyan, magenta

# Comportamiento
follow_now_playing_lyrics = yes
fetch_lyrics_for_current_song_in_background = yes
seek_time = 5
volume_change_step = 2
autocenter_mode = yes
centered_cursor = yes
cyclic_scrolling = yes
ignore_leading_the = yes
ignore_diacritics = yes
regular_expressions = extended
default_place_to_search_in = database
search_engine_default_search_mode = 1
