{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 4,

  "modules-left": ["sway/workspaces", "custom/music", "sway/mode"],
  "modules-center": ["clock"],
  "modules-right": ["custom/capslock", "custom/disk", "cpu", "memory", "bluetooth", "network", "pulseaudio", "backlight", "battery", "custom/power"],

  "custom/music": {
    "exec": "~/.local/bin/waybar-music --watch",
    "return-type": "text",
    "on-click": "~/.local/bin/waybar-music --open",
    "on-click-right": "~/.local/bin/waybar-music --toggle",
    "on-scroll-up": "~/.local/bin/waybar-music --next",
    "on-scroll-down": "~/.local/bin/waybar-music --prev",
    "tooltip": true,
    "tooltip-format": "Click: abrir reproductor activo | Click derecho: reproducir/pausar | Scroll: cambiar tema"
  },

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}"
  },

  "clock": {
    "format": " {:%H:%M}",
    "format-alt": " {:%d/%m/%Y %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },

  "custom/capslock": {
    "exec": "~/.local/bin/waybar-capslock",
    "return-type": "json",
    "interval": 1,
    "format": "{}",
    "tooltip": true
  },

  "custom/disk": {
    "exec": "~/.local/bin/disk-status",
    "return-type": "json",
    "interval": 10,
    "format": "{}",
    "on-click": "~/.local/bin/disk-manager",
    "tooltip": true
  },

  "cpu": {
    "format": "󰻠 {usage}%",
    "interval": 3,
    "on-click": "foot --app-id foot-system -e btop",
    "tooltip": true
  },

  "memory": {
    "format": "󰍛 {used:0.1f}G",
    "interval": 3,
    "on-click": "foot --app-id foot-system -e btop",
    "tooltip": true
  },

  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱 {device_alias}",
    "format-disabled": "󰂲 apagado",
    "format-off": "󰂲 apagado",
    "format-no-controller": "󰂲 sin BT",
    "tooltip-format": "Bluetooth: {status}\nControlador: {controller_alias}\nClick para abrir bluetui",
    "tooltip-format-connected": "Conectado: {device_alias}\nControlador: {controller_alias}\nClick para abrir bluetui",
    "tooltip-format-disabled": "Bluetooth apagado\nClick para abrir bluetui",
    "on-click": "~/.local/bin/bluetooth-menu"
  },

  "network": {
    "format-wifi": "󰤨 {essid}",
    "format-disconnected": "󰤭 Sin red",
    "tooltip-format-wifi": "Red: {essid}\nInterfaz: {ifname}\nIP: {ipaddr}\nSeñal: {signalStrength}%",
    "tooltip-format-disconnected": "Sin conexión\nClick para abrir redes",
    "on-click": "~/.local/bin/network-menu"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 silenciado",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "tooltip-format": "Audio: {desc}\nVolumen: {volume}%\nClick: pulsemixer\nClick derecho: cambiar salida",
    "tooltip-format-muted": "Audio silenciado: {desc}\nClick: pulsemixer\nClick derecho: cambiar salida",
    "on-click": "~/.local/bin/audio-menu",
    "on-click-right": "~/.local/bin/audio-output-menu"
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "tooltip": true,
    "tooltip-format": "Brillo: {percent}%"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-full": "󰁹 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip": true,
    "tooltip-format": "Batería: {capacity}%\nClick para ver detalles",
    "on-click": "~/.local/bin/battery-menu"
  },
  "custom/power": {
    "format": "⏻",
    "on-click": "~/.local/bin/power-menu",
    "tooltip": true,
    "tooltip-format": "Opciones de energía"
  }

}
