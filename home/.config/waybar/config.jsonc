{
  "layer": "top",
  "position": "top",
  "height": 33,
  "spacing": 4,

  "modules-left": ["sway/workspaces", "custom/music", "sway/mode"],
  "modules-center": ["clock"],
  "modules-right": ["custom/capslock", "custom/dnd", "custom/disk", "bluetooth", "network", "pulseaudio", "backlight", "custom/battery", "custom/power"],

  "custom/music": {
    "exec": "~/.local/bin/waybar-music --watch",
    "return-type": "text",
    "escape": true,
    "on-click": "~/.local/bin/waybar-music --open",
    "on-click-right": "~/.local/bin/waybar-music --toggle",
    "on-scroll-up": "~/.local/bin/waybar-music --next",
    "on-scroll-down": "~/.local/bin/waybar-music --prev",
    "tooltip": true,
    "tooltip-format": "Click: abrir reproductor activo | Click derecho: reproducir/pausar | Scroll: siguiente/anterior"
  },

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}"
  },

  "clock": {
    "locale": "es_AR.UTF-8",
    "format": " {:L%a %d · %H:%M}",
    "format-alt": " {:L%A %d de %B de %Y · %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },

  "custom/capslock": {
    "exec": "~/.local/bin/waybar-capslock",
    "return-type": "json",
    "interval": 1,
    "format": "{}",
    "tooltip": true
  },

  "custom/dnd": {
    "exec": "~/.local/bin/notification-mode --status",
    "return-type": "json",
    "interval": 5,
    "format": "{}",
    "on-click": "~/.local/bin/notification-mode --toggle",
    "tooltip": true
  },

  "custom/disk": {
    "exec": "~/.local/bin/disk-status",
    "return-type": "json",
    "interval": 10,
    "format": "{}",
    "on-click": "~/.local/bin/disk-manager",
    "tooltip": true
  },

  "cpu": {
    "format": "󰻠  {usage}%",
    "interval": 3,
    "on-click": "foot --app-id foot-system -e btop",
    "tooltip": true
  },

  "memory": {
    "format": "󰍛  {used:0.1f}G",
    "interval": 3,
    "on-click": "foot --app-id foot-system -e btop",
    "tooltip": true
  },

  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱  {device_alias}",
    "format-connected-battery": "󰂱  {device_alias}    {device_battery_percentage}%",
    "format-disabled": "󰂲  apagado",
    "format-off": "󰂲  apagado",
    "format-no-controller": "󰂲  sin BT",
    "tooltip-format": "Bluetooth: {status}\nControlador: {controller_alias}\nClick para abrir bluetui",
    "tooltip-format-connected": "Conectado: {device_alias}\nControlador: {controller_alias}\nClick para abrir bluetui",
    "tooltip-format-connected-battery": "Conectado: {device_alias}\nBatería: {device_battery_percentage}%\nControlador: {controller_alias}\nClick para abrir bluetui",
    "tooltip-format-disabled": "Bluetooth apagado\nClick para abrir bluetui",
    "on-click": "~/.local/bin/bluetooth-menu"
  },

  "network": {
    "format-wifi": "󰤨  {essid}",
    "format-disconnected": "󰤭  Sin red",
    "tooltip-format-wifi": "Red: {essid}\nInterfaz: {ifname}\nIP: {ipaddr}\nSeñal: {signalStrength}%",
    "tooltip-format-disconnected": "Sin conexión\nClick para abrir redes",
    "on-click": "~/.local/bin/network-menu"
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  silenciado",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "tooltip-format": "Audio: {desc}\nVolumen: {volume}%\nClick: pulsemixer\nClick derecho: cambiar salida",
    "tooltip-format-muted": "Audio silenciado: {desc}\nClick: pulsemixer\nClick derecho: cambiar salida",
    "on-click": "~/.local/bin/audio-menu",
    "on-click-right": "~/.local/bin/audio-output-menu"
  },

  "backlight": {
    "format": "{icon}  {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "tooltip": true,
    "tooltip-format": "Brillo: {percent}%"
  },

  "custom/battery": {
    "exec": "~/.local/bin/waybar-battery",
    "return-type": "json",
    "interval": 20,
    "format": "{}",
    "on-click": "~/.local/bin/battery-menu",
    "tooltip": true
  },
  "custom/power": {
    "format": "⏻",
    "on-click": "~/.local/bin/power-menu",
    "tooltip": true,
    "tooltip-format": "Opciones de energía"
  }

}
