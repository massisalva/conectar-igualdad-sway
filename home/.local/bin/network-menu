#!/usr/bin/env bash

notify_info() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "Redes" "$1" 2>/dev/null || true
  fi
}

if ! command -v foot >/dev/null 2>&1; then
  notify_info "No encontré foot"
  exit 1
fi

if ! command -v impala >/dev/null 2>&1; then
  notify_info "No encontré Impala"
  exit 1
fi

exec foot \
  --app-id impala-floating \
  --title "Redes" \
  --override=main.font="JetBrainsMono Nerd Font:size=8.5" \
  --override=main.pad=6x4 \
  --override=colors-dark.alpha=1.0 \
  --window-size-chars=76x20 \
  -e impala
