#!/usr/bin/env bash

set -u

if ! command -v fuzzel >/dev/null 2>&1; then
  command -v notify-send >/dev/null 2>&1 &&
    notify-send "Atajos" "No se encontró fuzzel" 2>/dev/null || true
  exit 1
fi

menu() {
  local prompt="$1"
  local lines="$2"
  shift 2

  printf '%s\n' "$@" |
    fuzzel --dmenu --font='Lexend:size=10' --line-height=21 \
      --width=55 --lines="$lines" --prompt="$prompt"
}

show_page() {
  local title="$1"
  shift
  menu "$title: " "$(( $# + 1 ))" "$@" '← Volver' >/dev/null || true
}

while true; do
  category="$(
    menu 'Atajos: ' 11 \
      'Aplicaciones' \
      'Foco y movimiento' \
      'Escritorios' \
      'Apertura y disposición' \
      'Flotantes y scratchpad' \
      'Redimensionado' \
      'Multimedia' \
      'Capturas' \
      'Sistema y sesión' \
      'Notificaciones' \
      'Salir'
  )" || exit 0

  case "$category" in
    'Aplicaciones')
      show_page 'Aplicaciones' \
        'Super + D       Lanzador de aplicaciones' \
        'Super + Enter   Terminal' \
        'Super + B       Firefox' \
        'Super + E       Archivos' \
        'Super + M       Música' \
        'Super + P       CPU y memoria'
      ;;
    'Foco y movimiento')
      show_page 'Foco y movimiento' \
        'Super + H/J/K/L o flechas          Cambiar el foco' \
        'Super + Shift + H/J/K/L o flechas  Mover ventana' \
        'Super + A                          Enfocar contenedor padre' \
        'Super + Shift + A                  Enfocar contenedor hijo' \
        'Super + U                          Ir a la ventana urgente' \
        'Super + Q                          Cerrar ventana'
      ;;
    'Escritorios')
      show_page 'Escritorios' \
        '1–5 con nombre: term, web, music, files, system' \
        '6–10 disponibles cuando los necesites' \
        'Super + 1–9          Ir al escritorio 1–9' \
        'Super + 0            Ir al escritorio 10' \
        'Super + Shift + 1–9  Mover ventana sin seguirla' \
        'Super + Shift + 0    Mover al 10 sin seguirla' \
        'Super + Ctrl + 1–9   Mover ventana y seguirla' \
        'Super + Ctrl + 0     Mover al 10 y seguirla' \
        'Super + Tab          Volver al escritorio anterior'
      ;;
    'Apertura y disposición')
      show_page 'Apertura y disposición' \
        'Super + V          Abrir la próxima ventana debajo' \
        'Super + Shift + B  Abrir la próxima ventana al lado' \
        'Super + S          Apilar ventanas' \
        'Super + W          Mostrar ventanas en pestañas' \
        'Super + T          Alternar mosaico horizontal/vertical' \
        'Super + F          Alternar pantalla completa'
      ;;
    'Flotantes y scratchpad')
      show_page 'Flotantes y scratchpad' \
        'Super + Shift + Espacio  Alternar ventana flotante' \
        'Super + Espacio          Foco entre mosaico y flotantes' \
        'Super + Shift + F        Centrar ventana flotante' \
        'Super + Shift + -        Enviar al scratchpad' \
        'Super + -                Mostrar/ocultar scratchpad'
      ;;
    'Redimensionado')
      show_page 'Redimensionado' \
        'Super + R                    Entrar al modo redimensionar' \
        'H o Izquierda              Reducir ancho 10 px' \
        'L o Derecha                Aumentar ancho 10 px' \
        'K o Arriba                 Reducir alto 10 px' \
        'J o Abajo                  Aumentar alto 10 px' \
        'Shift + dirección          Hacer el mismo cambio en 30 px' \
        'Enter o Escape             Salir del modo redimensionar'
      ;;
    'Multimedia')
      show_page 'Multimedia' \
        'Volumen + / -       Subir o bajar volumen' \
        'Silencio            Silenciar/activar audio' \
        'Silencio micrófono  Silenciar/activar micrófono' \
        'Play o Pausa        Reproducir/pausar' \
        'Pista siguiente     Avanzar pista' \
        'Pista anterior      Retroceder pista' \
        'Brillo + / -        Subir o bajar brillo'
      ;;
    'Capturas')
      show_page 'Capturas' \
        'Super + Shift + S      Abrir menú de capturas' \
        'Print                Guardar pantalla completa' \
        'Super + Print          Guardar una región' \
        'Shift + Print        Guardar la ventana enfocada' \
        'Ctrl + Print         Copiar pantalla completa' \
        'Super + Shift + Print  Copiar una región'
      ;;
    'Sistema y sesión')
      show_page 'Sistema' \
        'Super + Ctrl + L   Bloquear' \
        'Super + Ctrl + T   Activar/desactivar touchpad' \
        'Super + Shift + P  Menú de energía' \
        'Super + Shift + C  Recargar Sway' \
        'Super + Shift + E  Salir de Sway (con confirmación)' \
        'Super + F1         Mostrar esta guía'
      ;;
    'Notificaciones')
      show_page 'Notificaciones' \
        'Super + N          Cerrar la última' \
        'Super + Shift + N  Recuperar la última' \
        'Super + Ctrl + N   Alternar No molestar'
      ;;
    *) exit 0 ;;
  esac
done
