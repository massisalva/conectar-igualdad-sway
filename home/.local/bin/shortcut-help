#!/usr/bin/env bash

set -u

if ! command -v fuzzel >/dev/null 2>&1; then
  command -v notify-send >/dev/null 2>&1 &&
    notify-send "Atajos" "No se encontró fuzzel" 2>/dev/null || true
  exit 1
fi

printf '%s\n' \
  'Mod + D               Aplicaciones' \
  'Mod + Enter           Terminal' \
  'Mod + B               Firefox' \
  'Mod + E               Archivos' \
  'Mod + M               Música' \
  'Mod + P               CPU y memoria' \
  'Mod + 1…10            Cambiar de escritorio' \
  'Mod + Shift + 1…10    Mover ventana de escritorio' \
  'Mod + flechas         Cambiar el foco' \
  'Mod + Shift + flechas Mover ventana' \
  'Mod + F               Pantalla completa' \
  'Mod + R               Redimensionar' \
  'Mod + Q               Cerrar ventana' \
  'Mod + Ctrl + L        Bloquear' \
  'Mod + Shift + P       Menú de energía' \
  'Mod + Shift + S       Menú de capturas' \
  'Print                 Capturar pantalla' \
  'Mod + N               Cerrar notificación' \
  'Mod + Shift + N       Recuperar notificación' \
  'Mod + Ctrl + N        Alternar No molestar' \
  'Mod + F1              Mostrar esta ayuda' |
  fuzzel --dmenu --font='Lexend:size=9.5' --line-height=19 \
    --width=50 --lines=21 --prompt='Atajos: ' >/dev/null
