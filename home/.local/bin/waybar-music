#!/usr/bin/env bash

trap 'exit 0' PIPE
exec 2>/dev/null

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}"

PLAYLIST="$HOME/.config/pyradio/playlists/argentina.csv"

notify_info() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "Música" "$1" 2>/dev/null || true
  fi
}

shorten() {
  local text="$1"
  local max="${2:-36}"

  if [ "${#text}" -gt "$max" ]; then
    printf "%s…\n" "${text:0:$max}"
  else
    printf "%s\n" "$text"
  fi
}

music_player() {
  command -v playerctl >/dev/null 2>&1 || return 1
  playerctl -l 2>/dev/null | grep -Ei 'ncspot|spotify|mpv' | head -n1
}

mpd_state() {
  mpc status 2>/dev/null | sed -n '2p' | awk '{print $1}' | tr -d '[]'
}

mpd_song() {
  mpc status 2>/dev/null | sed -n '1p'
}

active_source() {
  local player status state song

  if current_radio >/dev/null; then
    printf 'radio\n'
    return
  fi

  state="$(mpd_state)"
  song="$(mpd_song)"
  if { [ "$state" = "playing" ] || [ "$state" = "paused" ]; } && [ -n "$song" ]; then
    printf 'mpd\n'
    return
  fi

  player="$(music_player || true)"
  if [ -n "$player" ]; then
    status="$(playerctl -p "$player" status 2>/dev/null || true)"
    if [ "$status" = "Playing" ] || [ "$status" = "Paused" ]; then
      printf 'player:%s\n' "$player"
      return
    fi
  fi

  printf 'mpd\n'
}

app_is_open() {
  local app_id="$1"

  command -v swaymsg >/dev/null 2>&1 || return 1
  [ -n "${SWAYSOCK:-}" ] || return 1

  swaymsg -t get_tree 2>/dev/null | python -c '
import json, sys

target = sys.argv[1]
tree = json.load(sys.stdin)

def walk(node):
    app_id = node.get("app_id") or node.get("window_properties", {}).get("class")
    if app_id == target:
        return True
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        if walk(child):
            return True
    return False

sys.exit(0 if walk(tree) else 1)
' "$app_id"
}

focus_or_exec() {
  local app_id="$1"
  shift

  if app_is_open "$app_id"; then
    swaymsg "[app_id=\"$app_id\"] focus" >/dev/null 2>&1 && exit 0
  fi

  "$@" >/dev/null 2>&1 &
}

open_active() {
  local source
  source="$(active_source)"

  case "$source" in
    radio)
      focus_or_exec pyradio-music foot --app-id pyradio-music -e pyradio
      ;;
    mpd)
      focus_or_exec foot-music foot --app-id foot-music -e ncmpcpp
      ;;
    player:*ncspot*)
      focus_or_exec ncspot-music foot --app-id ncspot-music -e ncspot
      ;;
    player:*spotify*)
      if command -v spotify >/dev/null 2>&1; then
        spotify >/dev/null 2>&1 &
      else
        notify_info "Spotify está reproduciendo, pero no encontré la app gráfica"
      fi
      ;;
    *)
      focus_or_exec foot-music foot --app-id foot-music -e ncmpcpp
      ;;
  esac
}

control_active() {
  local action="$1"
  local source player mpv_player

  source="$(active_source)"

  case "$source" in
    radio)
      mpv_player="$(command -v playerctl >/dev/null 2>&1 && playerctl -l 2>/dev/null | grep -Ei '^mpv' | head -n1 || true)"
      if [ -n "$mpv_player" ]; then
        playerctl -p "$mpv_player" "$action" >/dev/null 2>&1 || true
      else
        notify_info "PyRadio no expone controles MPRIS"
      fi
      ;;
    mpd)
      case "$action" in
        play-pause) mpc toggle >/dev/null 2>&1 || true ;;
        next) mpc next >/dev/null 2>&1 || true ;;
        previous) mpc prev >/dev/null 2>&1 || true ;;
      esac
      ;;
    player:*)
      player="${source#player:}"
      playerctl -p "$player" "$action" >/dev/null 2>&1 || true
      ;;
    *)
      mpc toggle >/dev/null 2>&1 || true
      ;;
  esac
}

normalize_url() {
  printf '%s\n' "$1" \
    | sed 's/&amp;/\&/g' \
    | sed 's/[?].*$//' \
    | sed 's#/$##'
}

radio_from_url() {
  local url="$1"
  local url_clean
  local name stream rest stream_clean

  [ -f "$PLAYLIST" ] || return 1
  [ -n "$url" ] || return 1

  url_clean="$(normalize_url "$url")"

  while IFS=',' read -r name stream rest; do
    [ -n "$name" ] || continue
    [ -n "$stream" ] || continue

    stream_clean="$(normalize_url "$stream")"

    if [ "$stream" = "$url" ] || [ "$stream_clean" = "$url_clean" ]; then
      printf "%s\n" "$name"
      return 0
    fi

    case "$url_clean" in
      *"$stream_clean"* )
        printf "%s\n" "$name"
        return 0
        ;;
    esac

    case "$stream_clean" in
      *"$url_clean"* )
        printf "%s\n" "$name"
        return 0
        ;;
    esac
  done < "$PLAYLIST"

  return 1
}

current_radio() {
  local line url station

  line="$(ps -eo args | grep -E '(^| )mpv .*--profile=pyradio' | grep -v grep | head -n1 || true)"
  [ -n "$line" ] || return 1

  url="$(printf '%s\n' "$line" | awk '{
    for (i=1; i<=NF; i++) {
      if ($i ~ /^https?:\/\//) {
        print $i
        exit
      }
    }
  }')"

  [ -n "$url" ] || return 1

  station="$(radio_from_url "$url" || true)"

  if [ -n "$station" ]; then
    station="$(shorten "$station" 30)"
    printf "󰠃 %s\n" "$station"
  else
    printf "󰠃 Radio\n"
  fi
}

current_song() {
  local mpd_status mpd_song mpd_state
  local player status artist title song

  # 0) PyRadio / mpv
  if current_radio; then
    return
  fi

  mpd_status="$(mpc status 2>/dev/null || true)"
  mpd_song="$(printf '%s\n' "$mpd_status" | sed -n '1p')"
  mpd_state="$(printf '%s\n' "$mpd_status" | sed -n '2p' | awk '{print $1}' | tr -d '[]')"

  # 1) MPD / ncmpcpp reproduciendo
  if [ "$mpd_state" = "playing" ] && [ -n "$mpd_song" ]; then
    song="$(shorten "$mpd_song" 36)"
    printf "󰎈 %s\n" "$song"
    return
  fi

  # 2) ncspot / Spotify reproduciendo
  if command -v playerctl >/dev/null 2>&1; then
    player="$(music_player | grep -Ei 'ncspot|spotify' | head -n1 || true)"

    if [ -n "$player" ]; then
      status="$(playerctl -p "$player" status 2>/dev/null || true)"

      if [ "$status" = "Playing" ]; then
        artist="$(playerctl -p "$player" metadata artist 2>/dev/null || true)"
        title="$(playerctl -p "$player" metadata title 2>/dev/null || true)"

        if [ -n "$title" ]; then
          if [ -n "$artist" ]; then
            song="$artist - $title"
          else
            song="$title"
          fi

          song="$(shorten "$song" 36)"
          printf "󰓇 %s\n" "$song"
          return
        fi
      fi
    fi
  fi

  # 3) MPD pausado
  if [ "$mpd_state" = "paused" ] && [ -n "$mpd_song" ]; then
    song="$(shorten "$mpd_song" 36)"
    printf "󰏤 %s\n" "$song"
    return
  fi

  # 4) ncspot / Spotify pausado
  if command -v playerctl >/dev/null 2>&1; then
    player="$(music_player | grep -Ei 'ncspot|spotify' | head -n1 || true)"

    if [ -n "$player" ]; then
      status="$(playerctl -p "$player" status 2>/dev/null || true)"

      if [ "$status" = "Paused" ]; then
        artist="$(playerctl -p "$player" metadata artist 2>/dev/null || true)"
        title="$(playerctl -p "$player" metadata title 2>/dev/null || true)"

        if [ -n "$title" ]; then
          if [ -n "$artist" ]; then
            song="$artist - $title"
          else
            song="$title"
          fi

          song="$(shorten "$song" 36)"
          printf "󰏤 %s\n" "$song"
          return
        fi
      fi
    fi
  fi

  printf "\n"
}

case "${1:-}" in
  --open)
    open_active
    exit 0
    ;;
  --toggle)
    control_active play-pause
    exit 0
    ;;
  --next)
    control_active next
    exit 0
    ;;
  --prev)
    control_active previous
    exit 0
    ;;
esac

if [ "${1:-}" = "--watch" ]; then
  last=""
  while true; do
    now="$(current_song)"
    if [ "$now" != "$last" ]; then
      printf "%s\n" "$now"
      last="$now"
    fi
    sleep 1
  done
else
  current_song
fi
