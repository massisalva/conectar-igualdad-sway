#!/usr/bin/env bash

set -u

notify_info() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "Fondos de pantalla" \
      -h string:x-canonical-private-synchronous:wallpaper-menu \
      "󰸉 Fondos de pantalla" "$1" 2>/dev/null || true
  fi
}

for command in fuzzel swaymsg; do
  if ! command -v "$command" >/dev/null 2>&1; then
    notify_info "No encontré $command"
    exit 1
  fi
done

pictures_dir="${XDG_PICTURES_DIR:-$HOME/Imágenes}"
# El fondo elegido se guarda en un archivo propio, fuera del repo: así el repo
# conserva el fondo predeterminado (20-appearance.conf) y check.sh/restore.sh no
# chocan con la elección local. Sway lo lee después (25 > 20), así que gana.
wallpaper_config="$HOME/.config/sway/config.d/25-fondo.conf"

if [ ! -d "$pictures_dir" ]; then
  notify_info "No existe la carpeta de imágenes"
  exit 1
fi

mapfile -d '' -t wallpapers < <(
  find "$pictures_dir" -maxdepth 1 -type f \
    \( -iname '*.avif' -o -iname '*.bmp' -o -iname '*.jpeg' -o -iname '*.jpg' -o -iname '*.png' -o -iname '*.webp' \) \
    -print0 | sort -z
)

if [ "${#wallpapers[@]}" -eq 0 ]; then
  notify_info "No encontré fondos en $pictures_dir"
  exit 0
fi

entries=()
for index in "${!wallpapers[@]}"; do
  printf -v entry '%03d  %s' "$((index + 1))" "$(basename "${wallpapers[$index]}")"
  entries+=("$entry")
done

selected="$(printf '%s\n' "${entries[@]}" | fuzzel --dmenu --width=55 --lines=10 --prompt='󰸉  Fondo: ')" || exit 0
selected_index="${selected%% *}"

if [[ ! "$selected_index" =~ ^[0-9]+$ ]]; then
  exit 0
fi

index=$((10#$selected_index - 1))
if [ "$index" -lt 0 ] || [ "$index" -ge "${#wallpapers[@]}" ]; then
  notify_info "La selección no es válida"
  exit 1
fi

wallpaper="${wallpapers[$index]}"
escaped_wallpaper="${wallpaper//\\/\\\\}"
escaped_wallpaper="${escaped_wallpaper//\"/\\\"}"
new_line="output * bg \"$escaped_wallpaper\" fill"
mkdir -p "$(dirname "$wallpaper_config")"
# El temporal no puede terminar en .conf: Sway incluye config.d/*.conf.
temporary_config="$(mktemp "${wallpaper_config%.conf}.XXXXXX")" || exit 1
trap 'rm -f "$temporary_config"' EXIT
{
  printf '%s\n' '# Fondo elegido con wallpaper-menu (Mod+Ctrl+W). Archivo local: no se versiona.'
  printf '%s\n' '# Borrarlo vuelve al fondo predeterminado de 20-appearance.conf.'
  printf '%s\n' "$new_line"
} > "$temporary_config"
chmod 644 "$temporary_config"

if ! swaymsg output '*' bg "$wallpaper" fill >/dev/null; then
  notify_info "Sway no pudo aplicar el fondo"
  exit 1
fi

mv "$temporary_config" "$wallpaper_config"
trap - EXIT
notify_info "Aplicado: $(basename "$wallpaper")"
