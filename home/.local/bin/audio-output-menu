#!/usr/bin/env bash

set -euo pipefail
export LC_ALL=C

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "Audio" -h string:x-canonical-private-synchronous:audio-output "󰓃 Audio" "$1" 2>/dev/null || true
  fi
}

for cmd in pactl fuzzel; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    notify "No encontré $cmd"
    exit 1
  fi
done

mapfile -t sinks < <(
  pactl list short sinks | awk -F '\t' '{print $1 "\t" $2}'
)

if [ "${#sinks[@]}" -eq 0 ]; then
  notify "No se encontraron salidas de audio."
  exit 1
fi

default="$(pactl get-default-sink 2>/dev/null || true)"
# Una sola consulta para todas las salidas (antes, una por salida).
sinks_detail="$(pactl list sinks)"

menu="$(
  for line in "${sinks[@]}"; do
    id="${line%%$'\t'*}"
    name="${line#*$'\t'}"

    desc="$(printf '%s\n' "$sinks_detail" | awk -v sink="Sink #$id" '
      $0 == sink {inside=1; next}
      /^Sink #/ {inside=0}
      inside && /^[[:space:]]*Description:/ {
        sub(/^[[:space:]]*Description:[[:space:]]*/, "")
        print
        exit
      }
    ')"

    [ -n "$desc" ] || desc="$name"

    marker=""
    if [ "$name" = "$default" ]; then
      marker="  [actual]"
    fi

    printf '[%s] %s%s\n' "$id" "$desc" "$marker"
  done
)"

choice="$(
  printf '%s\n' "$menu" \
    | fuzzel --dmenu --width=46 --lines="${#sinks[@]}" --prompt="󰓃 Salida de audio: "
)" || exit 0  # Esc: fuzzel sale con 1 y no es un error.

[ -n "$choice" ] || exit 0

selected_id="${choice%%]*}"
selected_id="${selected_id#[}"

case "$selected_id" in
  ''|*[!0-9]*) exit 1 ;;
esac

# Los índices de PulseAudio no son los IDs de nodo que espera wpctl.
# Resolver el nombre desde nuestra lista evita mezclar ambas APIs.
selected_name=""
for line in "${sinks[@]}"; do
  if [ "${line%%$'\t'*}" = "$selected_id" ]; then
    selected_name="${line#*$'\t'}"
    break
  fi
done
[ -n "$selected_name" ] || exit 1
pactl set-default-sink "$selected_name"

clean_choice="${choice#*] }"
clean_choice="${clean_choice%"  [actual]"}"
notify "Salida seleccionada: $clean_choice"
