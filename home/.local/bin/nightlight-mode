#!/usr/bin/env bash

set -u

is_active() {
  systemctl --user is-active --quiet wlsunset.service
}

status() {
  if is_active; then
    printf '{"text":"󰌵","class":"active","tooltip":"Luz nocturna activa\\nClick para desactivar"}\n'
  else
    printf '{"text":"󰌶","class":"inactive","tooltip":"Luz nocturna inactiva\\nClick para activar"}\n'
  fi
}

toggle() {
  if is_active; then
    systemctl --user stop wlsunset.service
    if command -v notify-send >/dev/null 2>&1; then
      notify-send -t 1500 -h string:x-canonical-private-synchronous:nightlight \
        "󰌵 Luz nocturna" "Filtro desactivado (color normal)" 2>/dev/null || true
    fi
  else
    systemctl --user start wlsunset.service
    if command -v notify-send >/dev/null 2>&1; then
      notify-send -t 1500 -h string:x-canonical-private-synchronous:nightlight \
        "󰌵 Luz nocturna" "Filtro activado (tono cálido)" 2>/dev/null || true
    fi
  fi
}

case "${1:---toggle}" in
  --status) status ;;
  --toggle) toggle ;;
  *) exit 2 ;;
esac
