#!/usr/bin/env bash

set -u

is_active() {
  systemctl --user is-active --quiet wlsunset.service
}

notify_nightlight() {
  local title="$1"
  local body="$2"

  command -v notify-send >/dev/null 2>&1 || return 0

  notify-send \
    -a "Luz nocturna" \
    -t 2000 \
    -u normal \
    -h string:x-canonical-private-synchronous:nightlight \
    "$title" \
    "$body" 2>/dev/null || true
}

status() {
  if is_active; then
    printf '{"text":"󰌵","class":"active","tooltip":"Luz nocturna activa\\nClick para desactivar"}\n'
  else
    printf '{"text":"󰌶","class":"inactive","tooltip":"Luz nocturna inactiva\\nClick para activar"}\n'
  fi
}

toggle() {
  if is_active; then
    systemctl --user stop wlsunset.service
    notify_nightlight "󰌶 Luz nocturna" "Filtro desactivado · 6500 K"
  else
    systemctl --user start wlsunset.service
    notify_nightlight "󰌵 Luz nocturna" "Filtro activado · 4500 K"
  fi
}

case "${1:---toggle}" in
  --status) status ;;
  --toggle) toggle ;;
  *) exit 2 ;;
esac
