#!/usr/bin/env bash

set -u

export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_TYPE=wayland
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"

if [ -z "${WAYLAND_DISPLAY:-}" ]; then
  WAYLAND_SOCKET="$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -type s -name 'wayland-*' | head -n1)"
  if [ -n "$WAYLAND_SOCKET" ]; then
    WAYLAND_DISPLAY="$(basename "$WAYLAND_SOCKET")"
    export WAYLAND_DISPLAY
  fi
fi

if [ -z "${SWAYSOCK:-}" ]; then
  SWAY_SOCKET="$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -type s -name 'sway-ipc.*.sock' | head -n1)"
  if [ -n "$SWAY_SOCKET" ]; then
    export SWAYSOCK="$SWAY_SOCKET"
  fi
fi

MENU="$(mktemp)"

cleanup() {
  rm -f "$MENU"
}
trap cleanup EXIT

declare -A SEEN
declare -A ACTION_BY_ID DEV_BY_ID MOUNTPOINT_BY_ID DISK_BY_ID FSTYPE_BY_ID
ITEM_COUNT=0

notify_info() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "Discos" -h string:x-canonical-private-synchronous:disk-manager "󰋊 Discos" "$1" 2>/dev/null || true
  fi
}

check_dependencies() {
  local cmd
  for cmd in lsblk python findmnt fuzzel udisksctl; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      notify_info "No encontré $cmd"
      exit 1
    fi
  done
}

open_yazi() {
  local dir="$1"

  if ! command -v foot >/dev/null 2>&1; then
    notify_info "No encontré foot"
    exit 1
  fi

  if ! command -v yazi >/dev/null 2>&1; then
    notify_info "No encontré yazi"
    exit 1
  fi

  foot --app-id foot-files -e yazi "$dir"
}

mounted_path() {
  local mounts
  mounts="$(findmnt --json -S "$1" -o TARGET 2>/dev/null)" || return 1
  # La salida raw de findmnt sustituye espacios por \\x20; JSON permite
  # recuperar el nombre real, incluyendo espacios y barras invertidas.
  python -c '
import json, sys
mounts = json.load(sys.stdin).get("filesystems") or []
if mounts:
    sys.stdout.write(mounts[0].get("target") or "")
' <<< "$mounts"
}

add_item() {
  local text="$1"
  local action="$2"
  local dev="$3"
  local mountpoint="$4"
  local disk="$5"
  local fstype="$6"

  ITEM_COUNT=$((ITEM_COUNT + 1))
  local id="$ITEM_COUNT"

  ACTION_BY_ID[$id]="$action"
  DEV_BY_ID[$id]="$dev"
  MOUNTPOINT_BY_ID[$id]="$mountpoint"
  DISK_BY_ID[$id]="$disk"
  FSTYPE_BY_ID[$id]="$fstype"
  printf '%s) %s\n' "$id" "$text" >> "$MENU"
}

check_dependencies

while IFS=$'\x1f' read -r NAME TYPE FSTYPE LABEL MOUNTPOINT PKNAME TRAN RM ROOT HAS_CHILDREN; do
  # crypt: el contenido ya desbloqueado de un disco cifrado (/dev/mapper/...).
  case "$TYPE" in part|disk|crypt) ;; *) continue ;; esac
  [ -n "$FSTYPE" ] || continue

  case "$MOUNTPOINT" in
    /|/boot|/boot/*|"[SWAP]") continue ;;
  esac

  case "$NAME" in
    /dev/zram*|/dev/loop*) continue ;;
  esac

  case "$TRAN:$RM" in
    usb:*|mmc:*|*:1) ;;
    *) continue ;;
  esac

  [ -n "${SEEN[$NAME]:-}" ] && continue
  SEEN[$NAME]=1

  LABEL_DISPLAY="${LABEL:-Sin etiqueta}"
  LABEL_DISPLAY="${LABEL_DISPLAY//$'\n'/ }"
  LABEL_DISPLAY="${LABEL_DISPLAY//$'\t'/ }"
  MOUNTED="$(mounted_path "$NAME" || true)"

  if [ -n "$ROOT" ]; then
    DISK="$ROOT"
  elif [ "$TYPE" = "disk" ]; then
    DISK="$NAME"
  elif [ -n "$PKNAME" ]; then
    DISK="$PKNAME"
  else
    DISK="/dev/$(lsblk -no PKNAME "$NAME" 2>/dev/null | head -n1)"
  fi

  if [ -z "$DISK" ] || [ "$DISK" = "/dev/" ]; then
    DISK="$NAME"
  fi

  if [ "$FSTYPE" = "crypto_LUKS" ]; then
    # Un contenedor cifrado no se monta: se desbloquea, y su contenido aparece
    # como otra entrada (tipo crypt) que sí se monta.
    if [ "$HAS_CHILDREN" = 1 ]; then
      add_item "󰌾  Bloquear | $LABEL_DISPLAY" "lock" "$NAME" "" "$DISK" "$FSTYPE"
    else
      add_item "󰌿  Desbloquear y montar | $LABEL_DISPLAY" "unlock" "$NAME" "" "$DISK" "$FSTYPE"
    fi
    add_item "󰓆  Expulsar | $LABEL_DISPLAY" "poweroff" "$NAME" "" "$DISK" "$FSTYPE"
  elif [ -n "$MOUNTED" ]; then
    add_item "󰉋  Abrir en yazi | $LABEL_DISPLAY" "open" "$NAME" "$MOUNTED" "$DISK" "$FSTYPE"
    add_item "󰍛  Desmontar | $LABEL_DISPLAY" "unmount" "$NAME" "$MOUNTED" "$DISK" "$FSTYPE"
    add_item "󰓆  Expulsar | $LABEL_DISPLAY" "poweroff" "$NAME" "$MOUNTED" "$DISK" "$FSTYPE"
  else
    add_item "󰋊  Montar | $LABEL_DISPLAY" "mount" "$NAME" "" "$DISK" "$FSTYPE"
    add_item "󰋊  Montar solo lectura | $LABEL_DISPLAY" "mount_ro" "$NAME" "" "$DISK" "$FSTYPE"
    add_item "󰓆  Expulsar | $LABEL_DISPLAY" "poweroff" "$NAME" "" "$DISK" "$FSTYPE"
  fi
done < <(
  lsblk -J -p -o NAME,TYPE,FSTYPE,LABEL,MOUNTPOINT,PKNAME,TRAN,RM |
  python -c '
import json, sys

data = json.load(sys.stdin)

def walk(nodes, parent_tran="", parent_rm="", root=""):
    for n in nodes:
        tran = n.get("tran") or parent_tran
        rm = n.get("rm")
        if rm is None:
            rm = parent_rm
        root_disk = root or n.get("name") or ""

        print(
            n.get("name") or "",
            n.get("type") or "",
            n.get("fstype") or "",
            n.get("label") or "",
            n.get("mountpoint") or "",
            n.get("pkname") or "",
            tran or "",
            "1" if rm is True or rm == "1" else "0",
            root_disk,
            "1" if n.get("children") else "0",
            sep="\x1f"
        )
        walk(n.get("children") or [], tran, rm, root_disk)

walk(data.get("blockdevices") or [])
'
)

if [ ! -s "$MENU" ]; then
  notify_info "No hay discos externos conectados"
  exit 0
fi

if [ "${DISK_MANAGER_DRY_RUN:-0}" = "1" ]; then
  cat "$MENU"
  exit 0
fi

CHOICE="$(cat "$MENU" | fuzzel --dmenu --width=42 --lines=8 --prompt="󰋊 Discos: ")"
[ -z "$CHOICE" ] && exit 0

ID="$(echo "$CHOICE" | cut -d')' -f1)"
case "$ID" in
  ''|*[!0-9]*) exit 1 ;;
esac

ACTION="${ACTION_BY_ID[$ID]:-}"
DEV="${DEV_BY_ID[$ID]:-}"
MOUNTPOINT="${MOUNTPOINT_BY_ID[$ID]:-}"
DISK="${DISK_BY_ID[$ID]:-}"
FSTYPE="${FSTYPE_BY_ID[$ID]:-}"

[ -n "$ACTION" ] || exit 1

case "$ACTION" in
  open)
    open_yazi "$MOUNTPOINT"
    ;;

  mount)
    if udisksctl mount -b "$DEV"; then
      notify_info "Disco montado"
    else
      notify_info "No pude montar el disco"
    fi
    ;;

  mount_ro)
    if udisksctl mount -b "$DEV" --options ro; then
      MOUNTED="$(mounted_path "$DEV" || true)"
      notify_info "Montado solo lectura"
      [ -n "$MOUNTED" ] && open_yazi "$MOUNTED"
    else
      notify_info "No pude montar solo lectura"
    fi
    ;;

  unlock)
    # La frase de paso se pide en una terminal: fuzzel no sirve para eso.
    if ! command -v foot >/dev/null 2>&1; then
      notify_info "No encontré foot"
      exit 1
    fi
    foot --app-id disk-unlock --title "Desbloquear disco" -e udisksctl unlock -b "$DEV"
    CLEAR="$(lsblk -nrpo NAME,TYPE "$DEV" 2>/dev/null | awk '$2 == "crypt" {print $1; exit}')"
    if [ -z "$CLEAR" ]; then
      notify_info "El disco sigue bloqueado"
      exit 1
    fi
    if udisksctl mount -b "$CLEAR"; then
      MOUNTED="$(mounted_path "$CLEAR" || true)"
      notify_info "Disco desbloqueado y montado"
      [ -n "$MOUNTED" ] && open_yazi "$MOUNTED"
    else
      notify_info "Desbloqueado, pero no pude montarlo"
      exit 1
    fi
    ;;

  lock)
    while IFS= read -r part; do
      [ -n "$part" ] || continue
      findmnt -rn -S "$part" >/dev/null 2>&1 || continue
      if ! err="$(udisksctl unmount -b "$part" 2>&1)"; then
        notify_info "No pude desmontar $part (¿hay algo abierto ahí?): ${err:-sin detalle}"
        exit 1
      fi
    done < <(lsblk -nrpo NAME "$DEV" 2>/dev/null)
    if err="$(udisksctl lock -b "$DEV" 2>&1)"; then
      notify_info "Disco bloqueado"
    else
      notify_info "No pude bloquear el disco: ${err:-sin detalle}"
      exit 1
    fi
    ;;

  unmount)
    if udisksctl unmount -b "$DEV"; then
      notify_info "Disco desmontado"
    else
      notify_info "No pude desmontar"
    fi
    ;;

  poweroff)
    # Apagar el disco exige desmontar todas sus particiones, no solo la elegida.
    while IFS= read -r part; do
      [ -n "$part" ] || continue
      findmnt -rn -S "$part" >/dev/null 2>&1 || continue
      if ! err="$(udisksctl unmount -b "$part" 2>&1)"; then
        notify_info "No pude desmontar $part antes de expulsar (¿hay algo abierto ahí?): ${err:-sin detalle}"
        exit 1
      fi
    done < <(lsblk -nrpo NAME "$DISK" 2>/dev/null)

    # Un contenedor cifrado abierto también impide apagar el disco.
    while read -r part fstype; do
      [ "$fstype" = crypto_LUKS ] || continue
      [ "$(lsblk -nrpo NAME "$part" 2>/dev/null | wc -l)" -gt 1 ] || continue
      if ! err="$(udisksctl lock -b "$part" 2>&1)"; then
        notify_info "No pude bloquear $part antes de expulsar: ${err:-sin detalle}"
        exit 1
      fi
    done < <(lsblk -nrpo NAME,FSTYPE "$DISK" 2>/dev/null)

    if err="$(udisksctl power-off -b "$DISK" 2>&1)"; then
      notify_info "Disco expulsado. Ya podés desconectarlo."
    else
      notify_info "No pude expulsar el disco: ${err:-sin detalle}"
      exit 1
    fi
    ;;
esac
