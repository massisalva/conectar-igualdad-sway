#!/usr/bin/env bash

notify_info() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "Batería" "$1" 2>/dev/null || true
  fi
}

if ! command -v foot >/dev/null 2>&1; then
  notify_info "No encontré foot"
  exit 1
fi

exec foot \
  --app-id battery-floating \
  --title "Batería" \
  --override=main.font="JetBrainsMono Nerd Font:size=9.5" \
  --override=main.pad=12x10 \
  --override=colors-dark.alpha=1.0 \
  --window-size-chars=72x23 \
  -e bash -lc '
found=0

for bat in /sys/class/power_supply/BAT*; do
  [ -d "$bat" ] || continue
  found=1

  name="$(basename "$bat")"
  status="$(cat "$bat/status" 2>/dev/null)"
  capacity="$(cat "$bat/capacity" 2>/dev/null)"
  health=""

  if [ -r "$bat/energy_full_design" ] && [ -r "$bat/energy_full" ]; then
    design="$(cat "$bat/energy_full_design")"
    full="$(cat "$bat/energy_full")"

    if [ "$design" -gt 0 ] 2>/dev/null; then
      health=$(( full * 100 / design ))
    fi
  elif [ -r "$bat/charge_full_design" ] && [ -r "$bat/charge_full" ]; then
    design="$(cat "$bat/charge_full_design")"
    full="$(cat "$bat/charge_full")"

    if [ "$design" -gt 0 ] 2>/dev/null; then
      health=$(( full * 100 / design ))
    fi
  fi

  printf "%s  |  %s  |  Carga: %s%%\n" "$name" "$status" "$capacity"
  if [ -n "$health" ]; then
    echo "Salud aprox.: ${health}%"
  fi

  echo
  echo "Datos técnicos:"
  grep -H . "$bat"/{manufacturer,model_name,technology,cycle_count,voltage_now,power_now,current_now,energy_now,energy_full,energy_full_design,charge_now,charge_full,charge_full_design} 2>/dev/null \
    | sed "s|$bat/||" \
    | sed "s/:/: /"
  echo
done

if [ "$found" -eq 0 ]; then
  echo "No se detectó batería en /sys/class/power_supply."
fi

echo
read -rp "Presioná Enter para cerrar..." </dev/tty
'
