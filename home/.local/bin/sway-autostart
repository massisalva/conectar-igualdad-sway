#!/usr/bin/env bash

set -uo pipefail

LOG_DIR="$HOME/.cache"
LOG="$LOG_DIR/sway-autostart.log"
mkdir -p "$LOG_DIR"

log() {
  printf '[%(%F %T)T] %s\n' -1 "$*" >> "$LOG"
}

export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_TYPE=wayland
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"

log "importando entorno Sway en systemd y D-Bus"
systemctl --user import-environment \
  WAYLAND_DISPLAY \
  XDG_CURRENT_DESKTOP \
  XDG_SESSION_TYPE \
  SWAYSOCK
dbus-update-activation-environment --systemd \
  WAYLAND_DISPLAY \
  XDG_CURRENT_DESKTOP \
  XDG_SESSION_TYPE \
  SWAYSOCK

mkdir -p "$HOME/Imágenes"

log "iniciando sway-session.target"
if ! systemctl --user start sway-session.target; then
  log "no pude iniciar sway-session.target"
  exit 1
fi

log "sesión Sway lista; esperando evento shutdown"
swaymsg -m -t subscribe '["shutdown"]' 2>/dev/null |
  while IFS= read -r event; do
    case "$event" in
      *'"change":"exit"'*)
        log "deteniendo sway-session.target"
        systemctl --user --no-block stop sway-session.target
        break
        ;;
    esac
  done
